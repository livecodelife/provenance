          "id": {
            "file": "cmd/provenance/merge_manifest_run.go",
            "name": "describeManifestLine"
          },
          "kwargs": {
            "code": "// describeManifestLine words one side of a conflicting manifest entry.\nfunc describeManifestLine(l record.ManifestLine, present bool) string {\n\tif !present {\n\t\treturn \"removed\"\n\t}\n\treturn fmt.Sprintf(\"version %d, %s\", l.Version, l.ContentHash)\n}",
            "file": "cmd/provenance/merge_manifest_run.go",
            "name": "describeManifestLine"
          },
          "kwargs_hash": "sha256:af834c51b6b0c72a53f0c4a123a4d3b62a593fda230f2525250f233a4f0db712",
          "body": "sha256:b74898961fffec13d275f04775726c432c7208e5791026960834dde7f9df3ac1"
        },
        {
          "path": "cmd/provenance/merge_manifest_run.go",
          "action": "setFunction",
          "variant": "",
          "tier": "owned",
          "pkg": "sha256:6589611adfb6618a7920e43f951a79901428192ea95c1084fde9f222aecd9537",
          "id": {
            "file": "cmd/provenance/merge_manifest_run.go",
            "name": "mergeManifests"
          },
          "kwargs": {
            "code": "// mergeManifests merges two manifests that both descend from base, one line\n// per record id. A record changed on one side takes that side's line; changed\n// on both, the higher version wins, and the same version with different content\n// (or a removal against a change) is a conflict.\nfunc mergeManifests(base, ours, theirs []record.ManifestLine) ([]record.ManifestLine, error) {\n\tindex := func(ls []record.ManifestLine) map[string]record.ManifestLine {\n\t\tm := make(map[string]record.ManifestLine, len(ls))\n\t\tfor _, l := range ls {\n\t\t\tm[l.ID] = l\n\t\t}\n\t\treturn m\n\t}\n\tb, o, t := index(base), index(ours), index(theirs)\n\tids := map[string]bool{}\n\tfor _, m := range []map[string]record.ManifestLine{b, o, t} {\n\t\tfor id := range m {\n\t\t\tids[id] = true\n\t\t}\n\t}\n\tvar out []record.ManifestLine\n\tfor id := range ids {\n\t\tbl, bok := b[id]\n\t\tol, ook := o[id]\n\t\ttl, tok := t[id]\n\t\tvar pick record.ManifestLine\n\t\tvar ok bool\n\t\tswitch {\n\t\tcase ook == tok \u0026\u0026 ol == tl:\n\t\t\tpick, ok = ol, ook\n\t\tcase ook == bok \u0026\u0026 ol == bl:\n\t\t\tpick, ok = tl, tok\n\t\tcase tok == bok \u0026\u0026 tl == bl:\n\t\t\tpick, ok = ol, ook\n\t\tcase ook \u0026\u0026 tok \u0026\u0026 ol.Version != tl.Version:\n\t\t\tpick, ok = ol, true\n\t\t\tif tl.Version \u003e ol.Version {\n\t\t\t\tpick = tl\n\t\t\t}\n\t\tdefault:\n\t\t\treturn nil, fmt.Errorf(\"%s: both branches changed it (ours: %s; theirs: %s); resolve the record files, then run provenance compile\", id, describeManifestLine(ol, ook), describeManifestLine(tl, tok))\n\t\t}\n\t\tif ok {\n\t\t\tout = append(out, pick)\n\t\t}\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].ID \u003c out[j].ID })\n\treturn out, nil\n}",
            "file": "cmd/provenance/merge_manifest_run.go",
            "name": "mergeManifests"
          },
          "kwargs_hash": "sha256:a2bb379f50f05b99f9140029170e60f1013c6cc746ad947f55e55a4061b14aff",
          "body": "sha256:a1894a0f866482f6b1d27e1e43fb516fc5999a48cfb5246e8464c5f88b1d4233"
        },
        {
          "path": "cmd/provenance/merge_manifest_run.go",
          "action": "setFunction",
          "variant": "",
          "tier": "owned",
          "pkg": "sha256:6589611adfb6618a7920e43f951a79901428192ea95c1084fde9f222aecd9537",
          "id": {
            "file": "cmd/provenance/merge_manifest_run.go",
            "name": "runMergeManifest"
          },
          "kwargs": {
            "code": "// runMergeManifest is git's merge driver for the version manifest: args are\n// the base, ours and theirs files, and the merged manifest replaces ours.\nfunc runMergeManifest(out io.Writer, cmd *cobra.Command, args []string) error {\n\tif len(args) != 3 {\n\t\treturn errors.New(\"usage: provenance merge-manifest BASE OURS THEIRS\")\n\t}\n\tvar sets [3][]record.ManifestLine\n\tfor i, p := range args {\n\t\tdata, err := os.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tlines, err := record.ParseManifest(data)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"%s: %w\", p, err)\n\t\t}\n\t\tsets[i] = lines\n\t}\n\tmerged, err := mergeManifests(sets[0], sets[1], sets[2])\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(args[1], record.MarshalManifest(merged), 0o644)\n}",
            "file": "cmd/provenance/merge_manifest_run.go",
            "name": "runMergeManifest"
          },
          "kwargs_hash": "sha256:cc92e592dde1ea882e41abab3467f00b0d6e689db2bce6936fe2212b4550d08d",
          "body": "sha256:eb421e719f90839ebcdb76dbc0fa5e7d37f3e28030aa9fb780c79820e9c8b9c1"
        }
      ]
    }
