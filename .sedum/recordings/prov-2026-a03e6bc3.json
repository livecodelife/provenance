            "file": "cmd/provenance/lint_run.go",
            "name": "lintRepo"
          },
          "kwargs": {
            "code": "func lintRepo(r *repo, enforcement string) (*lint.Result, error) {\n\tif enforcement == \"\" {\n\t\tenforcement = r.Config.Enforcement\n\t}\n\tif enforcement == \"\" {\n\t\tenforcement = \"none\"\n\t}\n\tshared, _ := loadShared(r)\n\treturn lint.Lint(r.Store, lint.Options{\n\t\tShared:       shared,\n\t\tRoot:         r.Root,\n\t\tEnforcement:  enforcement,\n\t\tExcludePaths: r.Config.ExcludePaths,\n\t\tSharedRepos:  sharedNames(r),\n\t\tManifestPath: manifestPath,\n\t})\n}",
            "file": "cmd/provenance/lint_run.go",
            "name": "lintRepo"
          },
          "kwargs_hash": "sha256:ad273542421d40abc0a159a39261fe35ab5732adfd6b38dc879d04de9fd987db",
