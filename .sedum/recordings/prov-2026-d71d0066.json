          "pkg": "sha256:6589611adfb6618a7920e43f951a79901428192ea95c1084fde9f222aecd9537",
          "id": {
            "file": "cmd/provenance/install_run.go",
            "name": "runInstallPlugin"
          },
          "kwargs": {
            "code": "func runInstallPlugin(out io.Writer, cmd *cobra.Command, args []string) error {\n\tr, err := openRepo(cmd)\n\tif err != nil {\n\t\treturn err\n\t}\n\tpath, _ := cmd.Flags().GetString(\"path\")\n\tforce, _ := cmd.Flags().GetBool(\"force\")\n\tbase, err := installBase(path, \".claude/plugins\")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn runInstall(out, r, \"plugins\", base, \"plugin\", force)\n}",
            "file": "cmd/provenance/install_run.go",
            "name": "runInstallPlugin"
          },
          "kwargs_hash": "sha256:5a387f8239df4c5cc4d04b6b82ccfc1bc4c31036fe3de374e377f60e4bd08a85",
