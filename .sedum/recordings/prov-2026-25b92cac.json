              "kwargs": {
                "code": "func pendingMergeParents(r *repo) []string {\n\thead, err := r.git(\"rev-parse\", \"HEAD\")\n\tif err != nil {\n\t\treturn nil\n\t}\n\trel, err := r.git(\"rev-parse\", \"--git-path\", \"MERGE_HEAD\")\n\tif err != nil {\n\t\treturn nil\n\t}\n\tpath := rel\n\tif !filepath.IsAbs(path) {\n\t\tpath = filepath.Join(r.Root, path)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\treturn nil\n\t}\n\tparents := []string{head}\n\tfor _, line := range strings.Split(string(data), \"\\n\") {\n\t\tline = strings.TrimSpace(line)\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tparents = append(parents, line)\n\t}\n\treturn parents\n}",
                "file": "cmd/provenance/merge_exempt_run.go",
                "name": "pendingMergeParents"
              }
            }
          ]
