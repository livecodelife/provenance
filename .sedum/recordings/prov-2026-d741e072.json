            {
              "action": "setFunction",
              "kwargs": {
                "code": "func commitTree(r *repo, rev string) (string, func(), error) {\n\tdir, err := os.MkdirTemp(\"\", \"provenance-commit-\")\n\tif err != nil {\n\t\treturn \"\", nil, err\n\t}\n\tscript := `git -C \"$1\" archive \"$2\" | tar -x -C \"$3\"`\n\tcmd := exec.Command(\"sh\", \"-c\", script, \"sh\", r.Root, rev, dir)\n\tcmd.Env = r.gitEnv()\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = \u0026stderr\n\tif err := cmd.Run(); err != nil {\n\t\tos.RemoveAll(dir)\n\t\treturn \"\", nil, fmt.Errorf(\"git archive %s: %w\\n%s\", rev, err, stderr.String())\n\t}\n\treturn dir, func() { os.RemoveAll(dir) }, nil\n}",
                "file": "cmd/provenance/check_commits_run.go",
                "name": "commitTree"
              }
            }
          ]
        }
