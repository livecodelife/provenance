            "name": "openScope"
          },
          "kwargs": {
            "code": "func openScope(recs []*record.Record) []string {\n\tseen := map[string]bool{}\n\tvar out []string\n\tfor _, rec := range recs {\n\t\tif rec.Status != record.StatusOpen || scope.Mode(rec) != \"allowlist\" {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, p := range rec.AffectedScope {\n\t\t\tif p != \"\" \u0026\u0026 !seen[p] {\n\t\t\t\tseen[p] = true\n\t\t\t\tout = append(out, p)\n\t\t\t}\n\t\t}\n\t}\n\tsort.Strings(out)\n\treturn out\n}",
            "file": "cmd/provenance/reconcile_run.go",
            "name": "openScope"
          },
          "kwargs_hash": "sha256:018579c4cfc86e42144fc550d10e54366531db98b555684cdb0883fb85263e38",
