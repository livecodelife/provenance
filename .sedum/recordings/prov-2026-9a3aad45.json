            {
              "action": "setType",
              "kwargs": {
                "code": "type reconcileResult struct {\n\tUnlocked []string\n\tLocked   []string\n}",
                "file": "cmd/provenance/reconcile_run.go",
                "name": "reconcileResult"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func isSnapshotFile(r *repo, rel string) bool {\n\treturn strings.HasSuffix(rel, \".yml\") \u0026\u0026 snapshotOwner(r, rel) != \"\"\n}",
                "file": "cmd/provenance/reconcile_run.go",
                "name": "isSnapshotFile"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func alwaysWritable(r *repo, recs []*record.Record) []string {\n\tout := append([]string{}, r.Config.ExcludePaths...)\n\tout = append(out, filepath.ToSlash(r.Config.Dir), \".provenance\", configFile, legacyConfigFile)\n\tfor _, rec := range recs {\n\t\tfor _, spec := range rec.AssociatedSpecs {\n\t\t\tif spec.Path != \"\" {\n\t\t\t\tout = append(out, spec.Path)\n\t\t\t}\n\t\t}\n\t}\n\treturn out\n}",
                "file": "cmd/provenance/reconcile_run.go",
                "name": "alwaysWritable"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func openScope(recs []*record.Record) []string {\n\tseen := map[string]bool{}\n\tvar out []string\n\tfor _, rec := range recs {\n\t\tif rec.Status != record.StatusOpen || scope.Mode(rec) != \"allowlist\" {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, p := range rec.AffectedScope {\n\t\t\tif p != \"\" \u0026\u0026 !seen[p] {\n\t\t\t\tseen[p] = true\n\t\t\t\tout = append(out, p)\n\t\t\t}\n\t\t}\n\t}\n\tsort.Strings(out)\n\treturn out\n}",
                "file": "cmd/provenance/reconcile_run.go",
                "name": "openScope"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func writablePath(r *repo, rel string, always, open []string, restricted bool) bool {\n\tif isSnapshotFile(r, rel) {\n\t\treturn false\n\t}\n\tif !restricted || scope.Excluded(rel, always) {\n\t\treturn true\n\t}\n\tfor _, p := range open {\n\t\tif ok, err := scope.Match(rel, p); err == nil \u0026\u0026 ok {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}",
                "file": "cmd/provenance/reconcile_run.go",
                "name": "writablePath"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func patternBaseDir(pattern string) string {\n\tbody := pattern\n\tmeta := \"*?\"\n\tif scope.IsRegex(pattern) {\n\t\tbody = strings.TrimPrefix(pattern[3:], \"^\")\n\t\tmeta = `.+*?()[]{}^$|\\`\n\t}\n\tsegments := strings.Split(body, \"/\")\n\tvar literal []string\n\tfor _, seg := range segments[:len(segments)-1] {\n\t\tif strings.ContainsAny(seg, meta) {\n\t\t\tbreak\n\t\t}\n\t\tliteral = append(literal, seg)\n\t}\n\treturn strings.Join(literal, \"/\")\n}",
                "file": "cmd/provenance/reconcile_run.go",
                "name": "patternBaseDir"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func reconcileFiles(r *repo, dry bool) (*reconcileResult, error) {\n\tres := \u0026reconcileResult{}\n\trestricted := r.Config.WriteRestriction == nil || *r.Config.WriteRestriction\n\tids, err := r.Store.List()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar recs []*record.Record\n\tfor _, id := range ids {\n\t\trec, _, err := r.Store.Load(id)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\trecs = append(recs, rec)\n\t}\n\tif restricted \u0026\u0026 len(recs) == 0 {\n\t\treturn res, nil\n\t}\n\tlisting, err := r.git(\"ls-files\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\talways, open := alwaysWritable(r, recs), openScope(recs)\n\tdirs := map[string]bool{}\n\tfor _, rel := range strings.Split(listing, \"\\n\") {\n\t\tif rel == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\twritable := writablePath(r, rel, always, open, restricted)\n\t\tif writable {\n\t\t\tdirs[filepath.Dir(rel)] = true\n\t\t}\n\t\tabs := filepath.Join(r.Root, rel)\n\t\tinfo, err := os.Lstat(abs)\n\t\tif err != nil || info.IsDir() {\n\t\t\tcontinue\n\t\t}\n\t\tcur := info.Mode().Perm()\u00260o200 != 0\n\t\tswitch {\n\t\tcase writable \u0026\u0026 !cur:\n\t\t\tif !dry {\n\t\t\t\tif err := os.Chmod(abs, info.Mode().Perm()|0o200); err != nil {\n\t\t\t\t\treturn nil, err\n\t\t\t\t}\n\t\t\t}\n\t\t\tres.Unlocked = append(res.Unlocked, rel)\n\t\tcase !writable \u0026\u0026 cur:\n\t\t\tif !dry {\n\t\t\t\tif err := os.Chmod(abs, info.Mode().Perm()\u0026^0o222); err != nil {\n\t\t\t\t\treturn nil, err\n\t\t\t\t}\n\t\t\t}\n\t\t\tres.Locked = append(res.Locked, rel)\n\t\t}\n\t}\n\tif restricted {\n\t\tfor _, p := range open {\n\t\t\tif scope.IsPattern(p) {\n\t\t\t\tif d := patternBaseDir(p); d != \"\" {\n\t\t\t\t\tdirs[d] = true\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, err := os.Lstat(filepath.Join(r.Root, p)); os.IsNotExist(err) {\n\t\t\t\tdirs[filepath.Dir(p)] = true\n\t\t\t}\n\t\t}\n\t}\n\tfor d := range dirs {\n\t\tif d == \".\" || d == \"\" || dry {\n\t\t\tcontinue\n\t\t}\n\t\tabs := filepath.Join(r.Root, d)\n\t\tif info, err := os.Lstat(abs); err == nil \u0026\u0026 info.IsDir() {\n\t\t\tif err := os.Chmod(abs, info.Mode().Perm()|0o300); err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t}\n\t}\n\tsort.Strings(res.Unlocked)\n\tsort.Strings(res.Locked)\n\treturn res, nil\n}",
                "file": "cmd/provenance/reconcile_run.go",
                "name": "reconcileFiles"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func reconcileQuietly(r *repo) {\n\tif _, err := reconcileFiles(r, false); err != nil {\n\t\treturn\n\t}\n}",
                "file": "cmd/provenance/reconcile_run.go",
                "name": "reconcileQuietly"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func runReconcile(out io.Writer, cmd *cobra.Command, args []string) error {\n\tr, err := openRepo(cmd)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdry, _ := cmd.Flags().GetBool(\"dry-run\")\n\tres, err := reconcileFiles(r, dry)\n\tif err != nil {\n\t\treturn err\n\t}\n\tverb := \"\"\n\tif dry {\n\t\tverb = \"Would \"\n\t}\n\tfmt.Fprintf(out, \"\\n✓ %sReconciled write permissions: %d unlocked, %d locked\\n\", verb, len(res.Unlocked), len(res.Locked))\n\tfor _, f := range res.Unlocked {\n\t\tfmt.Fprintf(out, \"    unlocked  %s\\n\", f)\n\t}\n\tfor _, f := range res.Locked {\n\t\tfmt.Fprintf(out, \"    locked    %s\\n\", f)\n\t}\n\tfmt.Fprint(out, \"\\n\")\n\treturn nil\n}",
                "file": "cmd/provenance/reconcile_run.go",
                "name": "runReconcile"
              }
            }
          ]
        }
