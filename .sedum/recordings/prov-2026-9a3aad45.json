          "id": {
            "file": "cmd/provenance/reconcile_run.go",
            "name": "patternBaseDir"
          },
          "kwargs": {
            "code": "func patternBaseDir(pattern string) string {\n\tbody := pattern\n\tmeta := \"*?\"\n\tif scope.IsRegex(pattern) {\n\t\tbody = strings.TrimPrefix(pattern[3:], \"^\")\n\t\tmeta = `.+*?()[]{}^$|\\`\n\t}\n\tsegments := strings.Split(body, \"/\")\n\tvar literal []string\n\tfor _, seg := range segments[:len(segments)-1] {\n\t\tif strings.ContainsAny(seg, meta) {\n\t\t\tbreak\n\t\t}\n\t\tliteral = append(literal, seg)\n\t}\n\treturn strings.Join(literal, \"/\")\n}",
            "file": "cmd/provenance/reconcile_run.go",
            "name": "patternBaseDir"
          },
          "kwargs_hash": "sha256:038c182bf7c8052700720801f4fcdd7fcda3883a13b59896a4b230c63da09636",
          "body": "sha256:a37b705bb3310cd006cae6ffef097e439fedbaad65840b0355a049b825b51ac5"
        },
        {
          "path": "cmd/provenance/reconcile_run.go",
          "action": "setFunction",
