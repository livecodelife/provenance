          "kwargs": {
            "code": "func writablePath(r *repo, rel string, always, open []string, restricted bool) bool {\n\tif isSnapshotFile(r, rel) {\n\t\treturn false\n\t}\n\tif !restricted || scope.Excluded(rel, always) {\n\t\treturn true\n\t}\n\tfor _, p := range open {\n\t\tif ok, err := scope.Match(rel, p); err == nil \u0026\u0026 ok {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}",
