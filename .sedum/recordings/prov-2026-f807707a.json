                "file": "cmd/provenance/shared_run.go",
                "path": "github.com/livecodelife/provenance/record"
              }
            },
            {
              "action": "setType",
              "kwargs": {
                "code": "type cacheMeta struct {\n\tFetchedAt   time.Time `json:\"fetched_at\"`\n\tRecordCount int       `json:\"record_count\"`\n\tRepoName    string    `json:\"repo_name\"`\n\tRepoURL     string    `json:\"repo_url\"`\n\tRepoRef     string    `json:\"repo_ref\"`\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "cacheMeta"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func sharedCacheRoot(sr sharedRepo) string {\n\thome, _ := os.UserHomeDir()\n\treturn filepath.Join(home, \".linespec\", \"cache\", fmt.Sprintf(\"%x\", sha256.Sum256([]byte(sr.URL))))\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "sharedCacheRoot"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func sharedCacheDir(sr sharedRepo) string {\n\treturn filepath.Join(sharedCacheRoot(sr), \"provenance\")\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "sharedCacheDir"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func readCacheMeta(sr sharedRepo) (cacheMeta, error) {\n\tvar meta cacheMeta\n\tdata, err := os.ReadFile(filepath.Join(sharedCacheRoot(sr), \".meta\"))\n\tif err != nil {\n\t\treturn meta, err\n\t}\n\treturn meta, json.Unmarshal(data, \u0026meta)\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "readCacheMeta"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func cacheTTL(r *repo) time.Duration {\n\tminutes := r.Config.CacheTTLMinutes\n\tif minutes \u003c= 0 {\n\t\tminutes = 60\n\t}\n\treturn time.Duration(minutes) * time.Minute\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "cacheTTL"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func cacheFresh(r *repo, sr sharedRepo) bool {\n\tmeta, err := readCacheMeta(sr)\n\treturn err == nil \u0026\u0026 time.Since(meta.FetchedAt) \u003c cacheTTL(r)\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "cacheFresh"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func loadShared(r *repo) (map[string]*record.Record, []string) {\n\tshared := map[string]*record.Record{}\n\tvar warnings []string\n\tfor _, sr := range r.Config.SharedRepos {\n\t\tdir := sharedCacheDir(sr)\n\t\tif _, err := os.Stat(dir); err != nil {\n\t\t\twarnings = append(warnings, fmt.Sprintf(\"shared repo %s has no cache: run 'provenance sync'\", sr.Name))\n\t\t\tcontinue\n\t\t}\n\t\tif !cacheFresh(r, sr) {\n\t\t\twarnings = append(warnings, fmt.Sprintf(\"the cache of shared repo %s is stale: run 'provenance sync'\", sr.Name))\n\t\t}\n\t\tfilepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {\n\t\t\tif err != nil {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\tname := d.Name()\n\t\t\tif d.IsDir() {\n\t\t\t\tif name == \".versions\" {\n\t\t\t\t\treturn filepath.SkipDir\n\t\t\t\t}\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\tif !strings.HasPrefix(name, \"prov-\") || !(strings.HasSuffix(name, \".yml\") || strings.HasSuffix(name, \".yaml\")) {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\tdata, err := os.ReadFile(path)\n\t\t\tif err != nil {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\tif rec, err := record.Decode(data); err == nil \u0026\u0026 rec.ID != \"\" {\n\t\t\t\tshared[rec.ID] = rec\n\t\t\t}\n\t\t\treturn nil\n\t\t})\n\t}\n\treturn shared, warnings\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "loadShared"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func sharedNames(r *repo) []string {\n\tvar names []string\n\tfor _, sr := range r.Config.SharedRepos {\n\t\tnames = append(names, sr.Name)\n\t}\n\treturn names\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "sharedNames"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func cleanGitEnv() []string {\n\tvar env []string\n\tfor _, kv := range os.Environ() {\n\t\tif !strings.HasPrefix(kv, \"GIT_\") {\n\t\t\tenv = append(env, kv)\n\t\t}\n\t}\n\treturn env\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "cleanGitEnv"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func fetchShared(sr sharedRepo, ref, dir string) (string, func(), error) {\n\ttmp, err := os.MkdirTemp(\"\", \"provenance-sync-\")\n\tif err != nil {\n\t\treturn \"\", nil, err\n\t}\n\tcleanup := func() { os.RemoveAll(tmp) }\n\tc := exec.Command(\"sh\", \"-c\", `git archive --remote=\"$0\" \"$1\" \"$2/\" | tar -x -C \"$3\"`, sr.URL, ref, dir, tmp)\n\tc.Env = cleanGitEnv()\n\tif err := c.Run(); err == nil {\n\t\tif _, err := os.Stat(filepath.Join(tmp, filepath.FromSlash(dir))); err == nil {\n\t\t\treturn tmp, cleanup, nil\n\t\t}\n\t}\n\tclone, err := os.MkdirTemp(\"\", \"provenance-sync-clone-\")\n\tif err != nil {\n\t\tcleanup()\n\t\treturn \"\", nil, err\n\t}\n\tboth := func() { cleanup(); os.RemoveAll(clone) }\n\tfor _, args := range [][]string{\n\t\t{\"clone\", \"--depth=1\", \"--filter=blob:none\", \"--sparse\", \"--branch=\" + ref, sr.URL, \".\"},\n\t\t{\"sparse-checkout\", \"set\", \"--no-cone\", dir},\n\t} {\n\t\tc := exec.Command(\"git\", args...)\n\t\tc.Dir = clone\n\t\tc.Env = cleanGitEnv()\n\t\tif out, err := c.CombinedOutput(); err != nil {\n\t\t\tboth()\n\t\t\treturn \"\", nil, fmt.Errorf(\"git %s failed for %s: %s\", args[0], sr.Name, strings.TrimSpace(string(out)))\n\t\t}\n\t}\n\treturn clone, both, nil\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "fetchShared"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func syncShared(r *repo, sr sharedRepo) (int, error) {\n\tref := sr.Ref\n\tif ref == \"\" {\n\t\tref = \"main\"\n\t}\n\tdir := sr.Dir\n\tif dir == \"\" {\n\t\tdir = \"provenance\"\n\t}\n\troot, cleanup, err := fetchShared(sr, ref, dir)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tdefer cleanup()\n\tentries, err := os.ReadDir(filepath.Join(root, filepath.FromSlash(dir)))\n\tif err != nil \u0026\u0026 !os.IsNotExist(err) {\n\t\treturn 0, err\n\t}\n\tprovDir := sharedCacheDir(sr)\n\tif err := os.MkdirAll(provDir, 0o755); err != nil {\n\t\treturn 0, err\n\t}\n\told, _ := os.ReadDir(provDir)\n\tfor _, e := range old {\n\t\tif !e.IsDir() {\n\t\t\tos.Remove(filepath.Join(provDir, e.Name()))\n\t\t}\n\t}\n\tcount := 0\n\tfor _, e := range entries {\n\t\tname := e.Name()\n\t\tif e.IsDir() || !(strings.HasSuffix(name, \".yml\") || strings.HasSuffix(name, \".yaml\")) {\n\t\t\tcontinue\n\t\t}\n\t\tdata, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(dir), name))\n\t\tif err != nil {\n\t\t\treturn count, err\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(provDir, name), data, 0o644); err != nil {\n\t\t\treturn count, err\n\t\t}\n\t\tcount++\n\t}\n\tmeta, err := json.Marshal(cacheMeta{FetchedAt: time.Now().UTC(), RecordCount: count, RepoName: sr.Name, RepoURL: sr.URL, RepoRef: ref})\n\tif err != nil {\n\t\treturn count, err\n\t}\n\treturn count, os.WriteFile(filepath.Join(sharedCacheRoot(sr), \".meta\"), meta, 0o644)\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "syncShared"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func runSync(out io.Writer, cmd *cobra.Command, args []string) error {\n\tr, err := openRepo(cmd)\n\tif err != nil {\n\t\treturn err\n\t}\n\tforce, _ := cmd.Flags().GetBool(\"force\")\n\tif len(r.Config.SharedRepos) == 0 {\n\t\tfmt.Fprintln(out, \"No shared_repos configured\")\n\t\treturn nil\n\t}\n\tfailed := false\n\tfor _, sr := range r.Config.SharedRepos {\n\t\tif !force \u0026\u0026 cacheFresh(r, sr) {\n\t\t\tfmt.Fprintf(out, \"✓ %s (%s) — cache is fresh, skipped\\n\", sr.Name, sr.URL)\n\t\t\tcontinue\n\t\t}\n\t\tcount, err := syncShared(r, sr)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(out, \"✗ %s (%s): %v\\n\", sr.Name, sr.URL, err)\n\t\t\tfailed = true\n\t\t\tcontinue\n\t\t}\n\t\tfmt.Fprintf(out, \"✓ Synced %s (%s) — %d records\\n\", sr.Name, sr.URL, count)\n\t}\n\tif failed {\n\t\treturn fmt.Errorf(\"one or more repos failed to sync\")\n\t}\n\treturn nil\n}",
                "file": "cmd/provenance/shared_run.go",
                "name": "runSync"
              }
            },
            {
              "action": "setArgs",
              "kwargs": {
                "arity": "none",
                "bin": "provenance",
                "command": "sync"
              }
            },
            {
              "action": "addFlag",
              "kwargs": {
                "bin": "provenance",
                "command": "sync",
                "flag": "force",
                "type": "bool",
                "usage": "Ignore the cache TTL and fetch again"
              }
            }
          ]
        }
