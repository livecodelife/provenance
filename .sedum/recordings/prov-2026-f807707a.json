          },
          "kwargs_hash": "sha256:f9cf6fcf09bb75fdba149334fd55161dd32ee4f6aa26ef53f0c9c25a8555358b",
          "body": "sha256:38cb2f66181930be3014b988361d5afe2f56d7055e477dd9c088f34864f734b7"
        },
        {
          "path": "cmd/provenance/shared_run.go",
          "action": "setFunction",
          "variant": "",
          "tier": "owned",
          "pkg": "sha256:6589611adfb6618a7920e43f951a79901428192ea95c1084fde9f222aecd9537",
          "id": {
            "file": "cmd/provenance/shared_run.go",
            "name": "runSync"
          },
          "kwargs": {
            "code": "func runSync(out io.Writer, cmd *cobra.Command, args []string) error {\n\tr, err := openRepo(cmd)\n\tif err != nil {\n\t\treturn err\n\t}\n\tforce, _ := cmd.Flags().GetBool(\"force\")\n\tif len(r.Config.SharedRepos) == 0 {\n\t\tfmt.Fprintln(out, \"No shared_repos configured\")\n\t\treturn nil\n\t}\n\tfailed := false\n\tfor _, sr := range r.Config.SharedRepos {\n\t\tif !force \u0026\u0026 cacheFresh(r, sr) {\n\t\t\tfmt.Fprintf(out, \"✓ %s (%s) — cache is fresh, skipped\\n\", sr.Name, sr.URL)\n\t\t\tcontinue\n\t\t}\n\t\tcount, err := syncShared(r, sr)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(out, \"✗ %s (%s): %v\\n\", sr.Name, sr.URL, err)\n\t\t\tfailed = true\n\t\t\tcontinue\n\t\t}\n\t\tfmt.Fprintf(out, \"✓ Synced %s (%s) — %d records\\n\", sr.Name, sr.URL, count)\n\t}\n\tif failed {\n\t\treturn fmt.Errorf(\"one or more repos failed to sync\")\n\t}\n\treturn nil\n}",
            "file": "cmd/provenance/shared_run.go",
            "name": "runSync"
          },
          "kwargs_hash": "sha256:e3f8be9f28b80adeb63cad17e8b04aaf07f51b579088978f7b658476d36f1f70",
          "body": "sha256:9e67628aea961ead727eb3570f9a53de8b64446e502cf8592507555ee3cbebc9"
        },
