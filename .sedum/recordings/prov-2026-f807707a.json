          "pkg": "sha256:6589611adfb6618a7920e43f951a79901428192ea95c1084fde9f222aecd9537",
          "id": {
            "file": "cmd/provenance/shared_run.go",
            "name": "syncShared"
          },
          "kwargs": {
            "code": "func syncShared(r *repo, sr sharedRepo) (int, error) {\n\tref := sr.Ref\n\tif ref == \"\" {\n\t\tref = \"main\"\n\t}\n\tdir := sr.Dir\n\tif dir == \"\" {\n\t\tdir = \"provenance\"\n\t}\n\troot, cleanup, err := fetchShared(sr, ref, dir)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tdefer cleanup()\n\tentries, err := os.ReadDir(filepath.Join(root, filepath.FromSlash(dir)))\n\tif err != nil \u0026\u0026 !os.IsNotExist(err) {\n\t\treturn 0, err\n\t}\n\tprovDir := sharedCacheDir(sr)\n\tif err := os.MkdirAll(provDir, 0o755); err != nil {\n\t\treturn 0, err\n\t}\n\told, _ := os.ReadDir(provDir)\n\tfor _, e := range old {\n\t\tif !e.IsDir() {\n\t\t\tos.Remove(filepath.Join(provDir, e.Name()))\n\t\t}\n\t}\n\tcount := 0\n\tfor _, e := range entries {\n\t\tname := e.Name()\n\t\tif e.IsDir() || !(strings.HasSuffix(name, \".yml\") || strings.HasSuffix(name, \".yaml\")) {\n\t\t\tcontinue\n\t\t}\n\t\tdata, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(dir), name))\n\t\tif err != nil {\n\t\t\treturn count, err\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(provDir, name), data, 0o644); err != nil {\n\t\t\treturn count, err\n\t\t}\n\t\tcount++\n\t}\n\tmeta, err := json.Marshal(cacheMeta{FetchedAt: time.Now().UTC(), RecordCount: count, RepoName: sr.Name, RepoURL: sr.URL, RepoRef: ref})\n\tif err != nil {\n\t\treturn count, err\n\t}\n\treturn count, os.WriteFile(filepath.Join(sharedCacheRoot(sr), \".meta\"), meta, 0o644)\n}",
            "file": "cmd/provenance/shared_run.go",
            "name": "syncShared"
          },
          "kwargs_hash": "sha256:7feb503fc13861c18819dc63c7662a11b097e04b3b0dfc4afd9647f0b9f13538",
