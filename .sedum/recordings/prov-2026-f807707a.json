            "name": "readCacheMeta"
          },
          "kwargs": {
            "code": "func readCacheMeta(sr sharedRepo) (cacheMeta, error) {\n\tvar meta cacheMeta\n\tdata, err := os.ReadFile(filepath.Join(sharedCacheRoot(sr), \".meta\"))\n\tif err != nil {\n\t\treturn meta, err\n\t}\n\treturn meta, json.Unmarshal(data, \u0026meta)\n}",
            "file": "cmd/provenance/shared_run.go",
