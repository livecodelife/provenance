              "action": "setFunction",
              "kwargs": {
                "code": "func openBrowser(url string) bool {\n\tvar cmd *exec.Cmd\n\tswitch runtime.GOOS {\n\tcase \"darwin\":\n\t\tcmd = exec.Command(\"open\", url)\n\tcase \"windows\":\n\t\tcmd = exec.Command(\"rundll32\", \"url.dll,FileProtocolHandler\", url)\n\tdefault:\n\t\tif os.Getenv(\"DISPLAY\") == \"\" \u0026\u0026 os.Getenv(\"WAYLAND_DISPLAY\") == \"\" {\n\t\t\treturn false\n\t\t}\n\t\tcmd = exec.Command(\"xdg-open\", url)\n\t}\n\tif err := cmd.Start(); err != nil {\n\t\treturn false\n\t}\n\treturn true\n}",
                "file": "cmd/provenance/login_run.go",
                "name": "openBrowser"
              }
