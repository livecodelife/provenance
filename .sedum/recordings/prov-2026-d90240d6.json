              "action": "setFunction",
              "kwargs": {
                "code": "func defaultTokenName(cmd *cobra.Command) (string, error) {\n\tr, err := openRepo(cmd)\n\tif err != nil {\n\t\treturn \"\", errors.New(\"--name is required outside a repository\")\n\t}\n\ttop, err := r.git(\"rev-parse\", \"--show-toplevel\")\n\tif err != nil {\n\t\treturn \"\", errors.New(\"--name is required outside a repository\")\n\t}\n\tname := filepath.Base(strings.TrimSpace(top))\n\tif out, err := r.git(\"remote\", \"get-url\", \"origin\"); err == nil {\n\t\tif u := repoURL(out); u != \"\" {\n\t\t\tname = path.Base(u)\n\t\t}\n\t}\n\treturn \"ci-\" + name, nil\n}",
                "file": "cmd/provenance/token_run.go",
                "name": "defaultTokenName"
              }
            }
          ]
