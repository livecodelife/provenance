            {
              "action": "setFunction",
              "kwargs": {
                "code": "func autoMergeTree(r *repo, first, second string) (string, []string, error) {\n\tcmd := exec.Command(\"git\", \"merge-tree\", \"--write-tree\", \"--name-only\", first, second)\n\tcmd.Dir = r.Root\n\tcmd.Env = r.gitEnv()\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tvar exitErr *exec.ExitError\n\t\tif !errors.As(err, \u0026exitErr) || exitErr.ExitCode() != 1 {\n\t\t\treturn \"\", nil, err\n\t\t}\n\t}\n\tlines := strings.Split(string(out), \"\\n\")\n\ttreeID := strings.TrimSpace(lines[0])\n\tif treeID == \"\" {\n\t\treturn \"\", nil, errors.New(\"merge-tree produced no tree id\")\n\t}\n\tvar paths []string\n\tfor _, line := range lines[1:] {\n\t\tif strings.TrimSpace(line) == \"\" {\n\t\t\tbreak\n\t\t}\n\t\tpaths = append(paths, strings.TrimSpace(line))\n\t}\n\treturn treeID, paths, nil\n}",
                "file": "cmd/provenance/merge_exempt_run.go",
                "name": "autoMergeTree"
              }
            }
          ]
        }
