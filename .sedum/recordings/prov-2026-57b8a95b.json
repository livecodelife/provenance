          "id": {
            "file": "cmd/provenance/edit_run.go",
            "name": "applySpecChanges"
          },
          "kwargs": {
            "code": "func applySpecChanges(r *repo, specs []record.AssociatedSpec, adds, removes []string) ([]record.AssociatedSpec, error) {\n\tout := append([]record.AssociatedSpec(nil), specs...)\n\tfor _, rm := range removes {\n\t\tat := -1\n\t\tfor i := range out {\n\t\t\tif out[i].Path == rm {\n\t\t\t\tat = i\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif at \u003c 0 {\n\t\t\tvar have []string\n\t\t\tfor _, s := range out {\n\t\t\t\thave = append(have, s.Path)\n\t\t\t}\n\t\t\treturn nil, fmt.Errorf(\"--remove-spec: no associated spec %q (has: %s)\", rm, strings.Join(have, \", \"))\n\t\t}\n\t\tout = append(out[:at], out[at+1:]...)\n\t}\n\tfor _, add := range adds {\n\t\tpath, runCmd, hasCmd := strings.Cut(add, \":\")\n\t\tif path == \"\" {\n\t\t\treturn nil, fmt.Errorf(\"--add-spec %q: want path or path:run_command\", add)\n\t\t}\n\t\tfor _, s := range out {\n\t\t\tif s.Path == path {\n\t\t\t\treturn nil, fmt.Errorf(\"--add-spec: %q is already an associated spec\", path)\n\t\t\t}\n\t\t}\n\t\tif _, err := os.Stat(filepath.Join(r.Root, path)); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"--add-spec: %q does not exist: create the proof file first\", path)\n\t\t}\n\t\tspec := record.AssociatedSpec{Path: path}\n\t\tif hasCmd {\n\t\t\tspec.RunCommand = runCmd\n\t\t}\n\t\tout = append(out, spec)\n\t}\n\treturn out, nil\n}",
            "file": "cmd/provenance/edit_run.go",
            "name": "applySpecChanges"
          },
          "kwargs_hash": "sha256:8320bbf9708d79e4126ec1b5a0d9ba09a5870dddf07a376ea86af7f8b6a8117a",
          "body": "sha256:3e2f817bbbcd9bbb9aeddc84cf2a9045c3eaa033d6f45f5faa24eef74262b865"
        },
        {
          "path": "cmd/provenance/edit_run.go",
          "action": "setFunction",
          "variant": "",
          "tier": "owned",
          "pkg": "sha256:6589611adfb6618a7920e43f951a79901428192ea95c1084fde9f222aecd9537",
          "id": {
            "file": "cmd/provenance/edit_run.go",
            "name": "applySpecEdits"
          },
          "kwargs": {
            "code": "func applySpecEdits(specs []record.AssociatedSpec, edits []string) ([]record.AssociatedSpec, error) {\n\tout := append([]record.AssociatedSpec(nil), specs...)\n\tfor _, e := range edits {\n\t\told, rest, ok := strings.Cut(e, \"=\")\n\t\tif !ok || old == \"\" || rest == \"\" {\n\t\t\treturn nil, fmt.Errorf(\"--set-spec %q: want \u003cold\u003e=\u003cnew\u003e or \u003cold\u003e=\u003cnew\u003e:\u003crun_command\u003e\", e)\n\t\t}\n\t\tnewPath, runCmd, hasCmd := strings.Cut(rest, \":\")\n\t\tat := -1\n\t\tfor i := range out {\n\t\t\tif out[i].Path == old {\n\t\t\t\tat = i\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif at \u003c 0 {\n\t\t\tvar have []string\n\t\t\tfor _, s := range out {\n\t\t\t\thave = append(have, s.Path)\n\t\t\t}\n\t\t\treturn nil, fmt.Errorf(\"--set-spec: no associated spec %q (has: %s)\", old, strings.Join(have, \", \"))\n\t\t}\n\t\tout[at].Path = newPath\n\t\tif hasCmd {\n\t\t\tout[at].RunCommand = runCmd\n\t\t}\n\t}\n\treturn out, nil\n}",
            "file": "cmd/provenance/edit_run.go",
            "name": "applySpecEdits"
          },
          "kwargs_hash": "sha256:feaa309e4751f4fa5967c1ad0ef31b105b0faa8992a58a656ec7ef7a10651b74",
          "body": "sha256:3052d083b37e1a694b20f68c88d9fb0713364cf4d822c7c2c64067300c3d3b36"
        },
        {
          "path": "cmd/provenance/edit_run.go",
          "action": "setFunction",
          "variant": "",
          "tier": "owned",
          "pkg": "sha256:6589611adfb6618a7920e43f951a79901428192ea95c1084fde9f222aecd9537",
          "id": {
            "file": "cmd/provenance/edit_run.go",
            "name": "removeIndexes"
          },
          "kwargs": {
            "code": "func removeIndexes(list []string, indexes []string) ([]string, error) {\n\tseen := map[int]bool{}\n\tvar positions []int\n\tfor _, raw := range indexes {\n\t\tn, err := strconv.Atoi(raw)\n\t\tif err != nil || n \u003c 1 || n \u003e len(list) {\n\t\t\treturn nil, fmt.Errorf(\"--remove-constraint %s: no constraint number %s (there are %d)\", raw, raw, len(list))\n\t\t}\n\t\tif !seen[n] {\n\t\t\tseen[n] = true\n\t\t\tpositions = append(positions, n)\n\t\t}\n\t}\n\tsort.Sort(sort.Reverse(sort.IntSlice(positions)))\n\tout := append([]string{}, list...)\n\tfor _, n := range positions {\n\t\tout = append(out[:n-1], out[n:]...)\n\t}\n\treturn out, nil\n}",
            "file": "cmd/provenance/edit_run.go",
            "name": "removeIndexes"
          },
          "kwargs_hash": "sha256:e7e5118b8f7c9e5818d8ac8041451380df23cdca67313763d6bceb551f0fa41e",
          "body": "sha256:49f1ad3875dd652c8616ea33d9db80b778829d5e976715fa862215750933269f"
        },
        {
          "path": "cmd/provenance/edit_run.go",
          "action": "setFunction",
