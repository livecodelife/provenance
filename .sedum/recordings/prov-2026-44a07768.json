            {
              "action": "setFunction",
              "kwargs": {
                "code": "func newID(year int, suffix string, taken map[string]bool) (string, error) {\n\tfor i := 0; i \u003c 100; i++ {\n\t\tb := make([]byte, 4)\n\t\tif _, err := rand.Read(b); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tid := fmt.Sprintf(\"prov-%d-%s\", year, hex.EncodeToString(b))\n\t\tif suffix != \"\" {\n\t\t\tid += \"-\" + suffix\n\t\t}\n\t\tif !taken[id] {\n\t\t\treturn id, nil\n\t\t}\n\t}\n\treturn \"\", fmt.Errorf(\"could not generate a unique id after 100 attempts\")\n}",
                "file": "cmd/provenance/create_run.go",
                "name": "newID"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func runCreate(out io.Writer, cmd *cobra.Command, args []string) error {\n\tr, err := openRepo(cmd)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\ttitle, _ := cmd.Flags().GetString(\"title\")\n\tintent, _ := cmd.Flags().GetString(\"intent\")\n\ttyp, _ := cmd.Flags().GetString(\"type\")\n\ttags, _ := cmd.Flags().GetStringArray(\"tag\")\n\tscope, _ := cmd.Flags().GetStringArray(\"scope\")\n\timplements, _ := cmd.Flags().GetString(\"implements\")\n\tlocked, _ := cmd.Flags().GetBool(\"locked\")\n\tnoEdit, _ := cmd.Flags().GetBool(\"no-edit\")\n\tsuffix, _ := cmd.Flags().GetString(\"id-suffix\")\n\n\tif typ != \"\" \u0026\u0026 !record.Type(typ).Valid(2) {\n\t\treturn fmt.Errorf(\"invalid type %q (brief|blueprint|imprint)\", typ)\n\t}\n\n\tcleanTags := []string{}\n\tfor _, t := range tags {\n\t\tfor _, p := range strings.Split(t, \",\") {\n\t\t\tp = strings.TrimSpace(p)\n\t\t\tif p != \"\" {\n\t\t\t\tcleanTags = append(cleanTags, p)\n\t\t\t}\n\t\t}\n\t}\n\n\ttaken := map[string]bool{}\n\tids, err := r.Store.List()\n\tif err != nil {\n\t\treturn err\n\t}\n\tfor _, existing := range ids {\n\t\ttaken[existing] = true\n\t\tloaded, _, err := r.Store.Load(existing)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, a := range loaded.Aliases {\n\t\t\ttaken[a] = true\n\t\t}\n\t}\n\n\tid, err := newID(time.Now().Year(), suffix, taken)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\tvar implementsID, implementsURI string\n\tvar implementsVersion int\n\tif strings.HasPrefix(implements, \"at://\") {\n\t\tparentID, ok := record.ParseImplementsURI(implements)\n\t\tif !ok {\n\t\t\treturn fmt.Errorf(\"invalid --implements %q: want a record id or at://\u003cdid\u003e/dev.provisio.provenance.record/\u003cid\u003e\", implements)\n\t\t}\n\t\timplementsID = parentID\n\t\timplementsURI = implements\n\t} else if implements != \"\" {\n\t\tparent, _, err := r.resolve(implements)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\timplementsID = parent.ID\n\t\timplementsVersion = parent.Version\n\t}\n\n\tif scope == nil {\n\t\tscope = []string{}\n\t}\n\n\trec := \u0026record.Record{\n\t\tSchema:            2,\n\t\tID:                id,\n\t\tTitle:             title,\n\t\tType:              record.Type(typ),\n\t\tStatus:            record.StatusDraft,\n\t\tCreatedAt:         time.Now().Format(\"2006-01-02\"),\n\t\tAuthor:            r.author(),\n\t\tVersion:           1,\n\t\tIntent:            intent,\n\t\tLocked:            locked,\n\t\tImplements:        implementsID,\n\t\tImplementsURI:     implementsURI,\n\t\tImplementsVersion: implementsVersion,\n\t\tConstraints:       []string{},\n\t\tAffectedScope:     scope,\n\t\tForbiddenScope:    []string{},\n\t\tRelated:           []string{},\n\t\tAssociatedTraces:  []string{},\n\t\tMonitors:          []string{},\n\t\tTags:              cleanTags,\n\t\tAssociatedSpecs:   []record.AssociatedSpec{},\n\t}\n\n\tif err := r.Store.Save(rec, nil); err != nil {\n\t\treturn err\n\t}\n\n\tpath := filepath.Join(r.Root, r.recordPath(id))\n\n\tif !noEdit {\n\t\teditor := os.Getenv(\"EDITOR\")\n\t\tif editor == \"\" {\n\t\t\teditor = \"vi\"\n\t\t}\n\t\tc := exec.Command(editor, path)\n\t\tc.Stdin = os.Stdin\n\t\tc.Stdout = os.Stdout\n\t\tc.Stderr = os.Stderr\n\t\tif err := c.Run(); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"Warning: Could not open editor: %v\\n\", err)\n\t\t}\n\t}\n\n\tfmt.Fprintf(out, \"\\n✓ Created %s\\n\\n\", path)\n\tif implementsURI != \"\" {\n\t\tfmt.Fprint(out, \"  The parent is in another account, so implements_version is 0 (unpinned); run provenance repin once the parent can be read.\\n\\n\")\n\t}\n\treturn nil\n}",
                "file": "cmd/provenance/create_run.go",
                "name": "runCreate"
              }
            }
          ]
        }
