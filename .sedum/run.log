ted Go.\"\n        },\n        \"file\": {\n          \"type\": \"string\",\n          \"required\": true,\n          \"description\": \"The Go file to write into. It must be one of the authorized files.\"\n        },\n        \"name\": {\n          \"type\": \"string\",\n          \"required\": true,\n          \"description\": \"The constant's name.\"\n        }\n      },\n      \"anchor\": [\n        \"decls\"\n      ],\n      \"requires\": [\n        \"code\"\n      ]\n    },\n    {\n      \"action\": \"setFunction\",\n      \"package\": \"go\",\n      \"description\": \"Defines one top-level function, replacing an earlier version of it.\",\n      \"kwargs\": {\n        \"code\": {\n          \"type\": \"literal\",\n          \"required\": true,\n          \"description\": \"The whole function declaration, signature and body, as gofmt-formatted Go.\"\n        },\n        \"file\": {\n          \"type\": \"string\",\n          \"required\": true,\n          \"description\": \"The Go file to write into. It must be one of the authorized files.\"\n        },\n        \"name\": {\n          \"type\": \"string\",\n          \"required\": true,\n          \"description\": \"The function's name.\"\n        }\n      },\n      \"anchor\": [\n        \"decls\"\n      ],\n      \"requires\": [\n        \"code\"\n      ]\n    },\n    {\n      \"action\": \"setMethod\",\n      \"package\": \"go\",\n      \"description\": \"Defines one method, replacing an earlier version of it.\",\n      \"kwargs\": {\n        \"code\": {\n          \"type\": \"literal\",\n          \"required\": true,\n          \"description\": \"The whole method declaration, receiver, signature and body, as gofmt-formatted Go.\"\n        },\n        \"file\": {\n          \"type\": \"string\",\n          \"required\": true,\n          \"description\": \"The Go file to write into. It must be one of the authorized files.\"\n        },\n        \"name\": {\n          \"type\": \"string\",\n          \"require