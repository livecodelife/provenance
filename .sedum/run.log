\\n\\t\\tif !ok {\\n\\t\\t\\treturn fmt.Errorf(\\\"invalid --implements %q: want a record id or at://<did>/dev.provisio.provenance.record/<id>\\\", implements)\\n\\t\\t}\\n\\t\\timplementsID = parentID\\n\\t\\timplementsURI = implements\\n\\t} else if implements != \\\"\\\" {\\n\\t\\tparent, _, err := r.resolve(implements)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\timplementsID = parent.ID\\n\\t\\timplementsVersion = parent.Version\\n\\t}\\n\\n\\tif scope == nil {\\n\\t\\tscope = []string{}\\n\\t}\\n\\n\\trec := &record.Record{\\n\\t\\tSchema:            2,\\n\\t\\tID:                id,\\n\\t\\tTitle:             title,\\n\\t\\tType:              record.Type(typ),\\n\\t\\tStatus:            record.StatusDraft,\\n\\t\\tCreatedAt:         time.Now().Format(\\\"2006-01-02\\\"),\\n\\t\\tAuthor:            r.author(),\\n\\t\\tVersion:           1,\\n\\t\\tIntent:            intent,\\n\\t\\tLocked:            locked,\\n\\t\\tImplements:        implementsID,\\n\\t\\tImplementsURI:     implementsURI,\\n\\t\\tImplementsVersion: implementsVersion,\\n\\t\\tConstraints:       []string{},\\n\\t\\tAffectedScope:     scope,\\n\\t\\tForbiddenScope:    []string{},\\n\\t\\tRelated:           []string{},\\n\\t\\tAssociatedTraces:  []string{},\\n\\t\\tMonitors:          []string{},\\n\\t\\tTags:              cleanTags,\\n\\t\\tAssociatedSpecs:   []record.AssociatedSpec{},\\n\\t}\\n\\n\\tif err := r.Store.Save(rec, nil); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\n\\tpath := filepath.Join(r.Root, r.recordPath(id))\\n\\n\\tif !noEdit {\\n\\t\\teditor := os.Getenv(\\\"EDITOR\\\")\\n\\t\\tif editor == \\\"\\\" {\\n\\t\\t\\teditor = \\\"vi\\\"\\n\\t\\t}\\n\\t\\tc := exec.Command(editor, path)\\n\\t\\tc.Stdin = os.Stdin\\n\\t\\tc.Stdout = os.Stdout\\n\\t\\tc.Stderr = os.Stderr\\n\\t\\tif err := c.Run(); err != nil {\\n\\t\\t\\tfmt.Fprintf(os.Stderr, \\\"Warning: Could not open editor: %v\\\\n\\\", err)\\n\\t\\t}\\n\\t}\\n\\n\\tfmt.Fprintf(out, \\\"\\\\n✓ Created %s\\\\n\\\\n\\\", path)\\n\\tif implementsURI != \\\"\\\" {\\n\\t\\tfmt.Fprint(out, \\\"  The parent is in another account, so implements_version is 0 (unpinned); run provenance repin once the parent can be read.\\\\n\\\\n\\\")\\n\\t}\\n\\treturn nil\\n}\", \"file\": \"cmd/provenance/create_run.go\", \"name\": \"runCreate\"}}]}" prompt_tokens=14294 completion_tokens=5494
