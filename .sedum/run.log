\\t}\\n\\t}\\n\\treturn set\\n}\", \"file\": \"cmd/provenance/evidence_run.go\", \"name\": \"behindSet\"}}, {\"action\": \"setFunction\", \"kwargs\": {\"code\": \"func currentEvidence(r *repo, rec *record.Record, behind map[string]bool) evidence.Current {\\n\\tcur := evidence.CurrentFor(rec, r.Store.Specs(), nil)\\n\\tcur.CodeHash = \\\"\\\"\\n\\tcur.Behind = behind[rec.ID]\\n\\treturn cur\\n}\", \"file\": \"cmd/provenance/evidence_run.go\", \"name\": \"currentEvidence\"}}, {\"action\": \"setFunction\", \"kwargs\": {\"code\": \"func evidenceFiles(r *repo, id string) map[string]bool {\\n\\tm := map[string]bool{}\\n\\tfiles, _ := filepath.Glob(filepath.Join(r.Root, r.Config.Dir, \\\".evidence\\\", id, \\\"*\\\"))\\n\\tfor _, f := range files {\\n\\t\\tm[f] = true\\n\\t}\\n\\treturn m\\n}\", \"file\": \"cmd/provenance/evidence_run.go\", \"name\": \"evidenceFiles\"}}, {\"action\": \"setFunction\", \"kwargs\": {\"code\": \"func recordEvidence(r *repo, rec *record.Record, passed bool) ([]string, error) {\\n\\tbefore := evidenceFiles(r, rec.ID)\\n\\tcur := currentEvidence(r, rec, behindSet(r))\\n\\te := evidence.New(rec, cur, passed, time.Now().UTC().Format(time.RFC3339), \\\"provenance complete\\\")\\n\\tif err := (&evidence.Store{Root: r.Root, Dir: r.Config.Dir}).Append(e); err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\tvar added []string\\n\\tfor f := range evidenceFiles(r, rec.ID) {\\n\\t\\tif !before[f] {\\n\\t\\t\\tadded = append(added, f)\\n\\t\\t}\\n\\t}\\n\\treturn added, nil\\n}\", \"file\": \"cmd/provenance/evidence_run.go\", \"name\": \"recordEvidence\"}}, {\"action\": \"setFunction\", \"kwargs\": {\"code\": \"func checkEvidence(r *repo) ([]evidenceRow, error) {\\n\\tids, err := r.Store.List()\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\tbehind := behindSet(r)\\n\\tstore := &evidence.Store{Root: r.Root, Dir: r.Config.Dir}\\n\\trows := []evidenceRow{}\\n\\tfor _, id := range ids {\\n\\t\\trec, _, err := r.Store.Load(id)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n\\t\\tif rec.Status != record.StatusImplemented {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tv, err := store.Status(rec, currentEvidence(r, rec, behind))\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n\\t\\trows = append(rows, evidenceRow{ID: rec.ID, Version: rec.Version, State: string(v.State), Passed: v.Passed, Reasons: v.Reasons})\\n\\t}\\n\\treturn rows, nil\\n}\", \"file\": \"cmd/provenance/evidence_run.go\", \"name\": \"checkEvidence\"}}, {\"action\": \"setFunction\", \"kwargs\": {\"code\": \"func evidenceFailing(row evidenceRow) bool {\\n\\treturn row.State == string(evidence.Stale) || (row.State != string(evidence.Missing) && !row.Passed)\\n}\", \"file\": \"cmd/provenance/evidence_run.go\", \"name\": \"evidenceFailing\"}}, {\"action\": \"setFunction\", \"kwargs\": {\"code\": \"func printEvidence(out io.Writer, rows []evidenceRow) {\\n\\tfmt.Fprint(out, \\\"\\\\nEVIDENCE\\\\n\\\\n\\\")\\n\\tcounts := map[string]int{}\\n\\tfor _, row := range rows {\\n\\t\\tcounts[row.State]++\\n\\t\\twhy := \\\"\\\"\\n\\t\\tif len(row.Reasons) > 0 {\\n\\t\\t\\twhy = fmt.Sprintf(\\\"%v\\\", row.Reasons)\\n\\t\\t}\\n\\t\\tif row.State != string(evidence.Missing) && !row.Passed {\\n\\t\\t\\twhy = \\\"specs failed \\\" + why\\n\\t\\t}\\n\\t\\tfmt.Fprintf(out, \\\"  %-22s %-8s %s\\\\n\\\", fmt.Sprintf(\\\"%s@%d\\\", row.ID, row.Version), row.State, why)\\n\\t}\\n\\tfmt.Fprintf(out, \\\"\\\\n  %d fresh, %d stale, %d unknown, %d missing\\\\n\\\", counts[\\\"fresh\\\"], counts[\\\"stale\\\"], counts[\\\"unknown\\\"], counts[\\\"missing\\\"])\\n\\tfmt.Fprint(out, \\\"\\\\n\\\")\\n}\", \"file\": \"cmd/provenance/evidence_run.go\", \"name\": \"printEvidence\"}}, {\"action\": \"setFunction\", \"kwargs\": {\"code\": \"func runCheckEvidence(out io.Writer, cmd *cobra.Command, r *repo) error {\\n\\trows, err := checkEvidence(r)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tasJSON, _ := cmd.Flags().GetBool(\\\"json\\\")\\n\\tif asJSON {\\n\\