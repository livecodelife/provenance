ng   `json:\\\"id\\\"`\\n\\tVersion int      `json:\\\"version\\\"`\\n\\tState   string   `json:\\\"state\\\"`\\n\\tPassed  bool     `json:\\\"passed\\\"`\\n\\tReasons []string `json:\\\"reasons,omitempty\\\"`\\n}\",\"file\":\"cmd/provenance/evidence_run.go\",\"name\":\"evidenceRow\"}}\n- {\"action\":\"setFunction\",\"kwargs\":{\"code\":\"func sedumRegions(r *repo, id string) ([]evidence.Region, bool) {\\n\\tgen := filepath.Join(r.Root, \\\"generators\\\")\\n\\tif _, err := os.Stat(gen); err != nil {\\n\\t\\tempty, err := os.MkdirTemp(\\\"\\\", \\\"provenance-nogenerators-\\\")\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, false\\n\\t\\t}\\n\\t\\tdefer os.RemoveAll(empty)\\n\\t\\tgen = empty\\n\\t}\\n\\tbin := os.Getenv(\\\"SEDUM_BIN\\\")\\n\\tif bin == \\\"\\\" {\\n\\t\\tbin = \\\"sedum\\\"\\n\\t}\\n\\tc := exec.Command(bin, \\\"regions\\\", \\\"--json\\\", \\\"--generators\\\", gen, \\\"--records\\\", filepath.Join(r.Root, r.Config.Dir), \\\"--record\\\", id)\\n\\tc.Dir = r.Root\\n\\tout, err := c.Output()\\n\\tif err != nil {\\n\\t\\treturn nil, false\\n\\t}\\n\\tvar doc struct {\\n\\t\\tRegions []evidence.Region `json:\\\"regions\\\"`\\n\\t}\\n\\tif json.Unmarshal(out, \\u0026doc) != nil {\\n\\t\\treturn nil, false\\n\\t}\\n\\treturn doc.Regions, true\\n}\",\"file\":\"cmd/provenance/evidence_run.go\",\"name\":\"sedumRegions\"}}\n- {\"action\":\"setFunction\",\"kwargs\":{\"code\":\"func behindSet(r *repo) map[string]bool {\\n\\tset := map[string]bool{}\\n\\tshared, _ := loadShared(r)\\n\\tfound, err := stale.FindShared(r.Store, shared)\\n\\tif err != nil {\\n\\t\\treturn set\\n\\t}\\n\\tfor _, f := range found {\\n\\t\\tif f.Kind != stale.Unknown {\\n\\t\\t\\tset[f.ID] = true\\n\\t\\t}\\n\\t}\\n\\treturn set\\n}\",\"file\":\"cmd/provenance/evidence_run.go\",\"name\":\"behindSet\"}}\n- {\"action\":\"setFunction\",\"kwargs\":{\"code\":\"func currentEvidence(r *repo, rec *record.Record, behind map[string]bool) evidence.Current {\\n\\tregions, ok := sedumRegions(r, 