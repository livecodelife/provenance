age}}\\n\\t\\tif f.File != \\\"\\\" {\\n\\t\\t\\tfiles[f.File] = true\\n\\t\\t\\tres.Locations = []sarifLocation{{PhysicalLocation: sarifPhysicalLocation{\\n\\t\\t\\t\\tArtifactLocation: sarifArtifactLocation{URI: f.File, URIBaseID: \\\"%SRCROOT%\\\"},\\n\\t\\t\\t\\tRegion:           sarifRegion{StartLine: 1, StartColumn: 1},\\n\\t\\t\\t}}}\\n\\t\\t}\\n\\t\\tprops := map[string]string{}\\n\\t\\tif f.RecordID != \\\"\\\" {\\n\\t\\t\\tprops[\\\"recordId\\\"] = f.RecordID\\n\\t\\t}\\n\\t\\tif f.Field != \\\"\\\" {\\n\\t\\t\\tprops[\\\"field\\\"] = f.Field\\n\\t\\t}\\n\\t\\tif len(props) > 0 {\\n\\t\\t\\tres.Properties = props\\n\\t\\t}\\n\\t\\tresults = append(results, res)\\n\\t}\\n\\tvar uris []string\\n\\tfor f := range files {\\n\\t\\turis = append(uris, f)\\n\\t}\\n\\tsort.Strings(uris)\\n\\tartifacts := []sarifArtifact{}\\n\\tfor _, uri := range uris {\\n\\t\\tart := sarifArtifact{Location: sarifArtifactLocation{URI: uri, URIBaseID: \\\"%SRCROOT%\\\"}, MimeType: sarifMime(uri)}\\n\\t\\tif data, err := os.ReadFile(filepath.Join(r.Root, filepath.FromSlash(uri))); err == nil {\\n\\t\\t\\tsum := sha256.Sum256(data)\\n\\t\\t\\tart.Hashes = map[string]string{\\\"sha-256\\\": hex.EncodeToString(sum[:])}\\n\\t\\t}\\n\\t\\tartifacts = append(artifacts, art)\\n\\t}\\n\\treturn sarifDoc{\\n\\t\\tSchema:  \\\"https://json.schemastore.org/sarif-2.1.0.json\\\",\\n\\t\\tVersion: \\\"2.1.0\\\",\\n\\t\\tRuns: []sarifRun{{\\n\\t\\t\\tTool:      sarifTool{Driver: sarifDriver{Name: \\\"provenance\\\", Version: sarifVersion(), InformationURI: \\\"https://github.com/livecodelife/provenance\\\", Rules: rules}},\\n\\t\\t\\tResults:   results,\\n\\t\\t\\tArtifacts: artifacts,\\n\\t\\t}},\\n\\t}\\n}\"}}, {\"action\": \"setFunction\", \"kwargs\": {\"file\": \"cmd/provenance/sarif_run.go\", \"name\": \"printSarif\", \"code\": \"func printSarif(out io.Writer, doc sarifDoc) error {\\n\\tenc := json.NewEncoder(out)\\n\\tenc.SetIndent(\\\"\\\", \\\"  \\\")\\n\\treturn enc.Encode(doc)\\n}\"}}, {\"action\": \"setFunction\", \"kwargs\": {\"file\": \"cmd/provenance/sarif_run.go\", \"name\": \"sarifLevel\", \"code\": \"func sarifLevel(sev lint.Severity) string {\\n\\tswitch sev {\\n\\tcase lint.SeverityError:\\n\\t\\treturn \\\"error\\\"\\n\\tcase lint.SeverityWarning:\\n\\t\\treturn \\\"warning\\\"\\n\\tdefault:\\n\\t\\treturn \\\"note\\\"\\n\\t}\\n}\"}}, {\"action\": \"setFunction\", \"kwargs\": {\"file\": \"cmd/provenance/sarif_run.go\", \"name\": \"lintFindings\", \"code\": \"func lintFindings(r *repo, res *lint.Result) []sarifFinding {\\n\\tvar out []sarifFinding\\n\\tfor _, issue := range res.Issues {\\n\\t\\tf := sarifFinding{RuleID: issue.Rule, Level: sarifLevel(issue.Severity), Message: issue.Message, RecordID: issue.RecordID, Field: issue.Field}\\n\\t\\tif issue.RecordID != \\\"\\\" {\\n\\t\\t\\tf.File = filepath.ToSlash(r.recordPath(issue.RecordID))\\n\\t\\t}\\n\\t\\tout = append(out, f)\\n\\t}\\n\\tsort.SliceStable(out, func(i, j int) bool {\\n\\t\\ta, b := out[i], out[j]\\n\\t\\tif a.File != b.File {\\n\\t\\t\\treturn a.File < b.File\\n\\t\\t}\\n\\t\\tif a.RuleID != b.RuleID {\\n\\t\\t\\treturn a.RuleID < b.RuleID\\n\\t\\t}\\n\\t\\treturn a.Message < b.Message\\n\\t})\\n\\treturn out\\n}\"}}]}" prompt_tokens=8190 completion_tokens=9167
