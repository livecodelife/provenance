{
  "format": "provenance.hashing",
  "corpus_version": 4,
  "description": "Golden cases for canonical record hashing (docs/HASHING.md): string normalization, gen_hash, content_hash, spec hashes and YAML decoding. Every case cites the record that decided it.",
  "cases": [
    {
      "id": "normalize/trim-and-collapse",
      "kind": "normalize",
      "decision": "prov-2026-20c3360e",
      "why": "Whitespace carries no meaning in a record's text, so re-wrapping or re-indenting must not look like a content change.",
      "input": "  Users  can\tsign\n\n in.  ",
      "output": "Users can sign in."
    },
    {
      "id": "normalize/only-whitespace-is-empty",
      "kind": "normalize",
      "decision": "prov-2026-20c3360e",
      "why": "A string of only whitespace normalizes to the empty string, the same value as missing.",
      "input": "\n \t ",
      "output": ""
    },
    {
      "id": "normalize/nfc-combining-mark",
      "kind": "normalize",
      "decision": "prov-2026-20c3360e",
      "why": "Two editors can type the same accented letter as one or two code points; NFC makes them the same bytes.",
      "input": "Café",
      "output": "Café"
    },
    {
      "id": "normalize/nfc-singleton",
      "kind": "normalize",
      "decision": "prov-2026-20c3360e",
      "why": "NFC also rewrites singletons such as U+212B ANGSTROM SIGN to U+00C5. An implementation that only composes combining marks misses it.",
      "input": "10 Å",
      "output": "10 Å"
    },
    {
      "id": "normalize/nfc-is-not-nfkc",
      "kind": "normalize",
      "decision": "prov-2026-20c3360e",
      "why": "Compatibility characters stay as written. NFKC would fold the ligature to 'fi' and the full-width digit to '1'.",
      "input": "ﬁle １",
      "output": "ﬁle １"
    },
    {
      "id": "normalize/nbsp-is-whitespace",
      "kind": "normalize",
      "decision": "prov-2026-20c3360e",
      "why": "U+00A0 is White_Space and pasted text often carries it; it collapses like a space.",
      "input": "a  b",
      "output": "a b"
    },
    {
      "id": "normalize/unicode-spaces-are-whitespace",
      "kind": "normalize",
      "decision": "prov-2026-20c3360e",
      "why": "Every White_Space code point counts: NEL, ogham, en quad through hair space, line and paragraph separators, narrow no-break, medium mathematical, ideographic.",
      "input": "ab c d e f g h i　j\u000bk\fl",
      "output": "a b c d e f g h i j k l"
    },
    {
      "id": "normalize/zero-width-and-bom-are-not-whitespace",
      "kind": "normalize",
      "decision": "prov-2026-20c3360e",
      "why": "U+200B, U+FEFF, U+180E and U+2060 are not White_Space. JavaScript's \\s matches U+FEFF; an implementation using it would strip this BOM and disagree.",
      "input": "﻿a​b᠎c⁠d",
      "output": "﻿a​b᠎c⁠d"
    },
    {
      "id": "normalize/case-and-punctuation-kept",
      "kind": "normalize",
      "decision": "prov-2026-20c3360e",
      "why": "Only whitespace is normalized. Case, punctuation and quoting are content.",
      "input": "  Don't  USE \"eval\"! ",
      "output": "Don't USE \"eval\"!"
    },
