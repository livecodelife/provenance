{
  "lexicon": 1,
  "id": "dev.provisio.provenance.defs",
  "description": "Shared shapes of provenance records. Field names are the snake_case names of the YAML record in camelCase.",
  "defs": {
    "hash": {
      "type": "string",
      "description": "\"sha256:\" followed by 64 lowercase hex digits.",
      "maxLength": 71
    },
    "specHash": {
      "type": "string",
      "description": "One associated spec's contribution to the content hash: a hash, the constant \"record-file/v1\" for a spec that is a record file, or the empty string when the file could not be read.",
      "maxLength": 71
    },
    "spec": {
      "type": "object",
      "description": "A proof artifact. runCommand is local-only and never published.",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "maxLength": 1024 },
        "type": { "type": "string", "maxLength": 64 }
      }
    },
    "content": {
      "type": "object",
      "description": "A record without its lifecycle and envelope fields (status, version, reason, sealed commit). Absent and empty are the same value.",
      "required": ["title", "intent"],
      "properties": {
        "title": { "type": "string", "maxLength": 1024 },
        "type": { "type": "string", "knownValues": ["brief", "blueprint", "imprint"] },
        "createdAt": { "type": "string", "description": "The day the record was created, YYYY-MM-DD.", "maxLength": 10 },
        "author": { "type": "string", "maxLength": 512 },
        "intent": { "type": "string", "maxLength": 200000 },
        "constraints": { "type": "array", "maxLength": 2000, "items": { "type": "string", "maxLength": 20000 } },
        "affectedScope": { "type": "array", "maxLength": 2000, "items": { "type": "string", "maxLength": 1024 } },
        "forbiddenScope": { "type": "array", "maxLength": 2000, "items": { "type": "string", "maxLength": 1024 } },
        "related": { "type": "array", "maxLength": 2000, "items": { "type": "string", "maxLength": 128 } },
        "tags": { "type": "array", "maxLength": 200, "items": { "type": "string", "maxLength": 128 } },
        "aliases": { "type": "array", "maxLength": 2000, "items": { "type": "string", "maxLength": 128 } },
        "implements": { "type": "string", "description": "Id of the parent record.", "maxLength": 128 },
        "implementsRepo": { "type": "string", "description": "Name of the repository holding the parent when it is not local.", "maxLength": 256 },
        "implementsVersion": { "type": "integer", "minimum": 0, "description": "Parent version last confirmed against; 0 or absent means unpinned." },
        "associatedSpecs": { "type": "array", "maxLength": 500, "items": { "type": "ref", "ref": "#spec" } },
        "associatedTraces": { "type": "array", "maxLength": 500, "items": { "type": "string", "maxLength": 1024 } },
        "monitors": { "type": "array", "maxLength": 500, "items": { "type": "string", "maxLength": 1024 } },
        "locked": { "type": "boolean" }
      }
    }
  }
}
